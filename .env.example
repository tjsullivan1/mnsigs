# Development Environment Variables
# Copy this file to .env.local and update with your actual values

# Backend API URL - point to your backend server
VITE_API_BASE_URL=http://localhost:8000

# PayPal Client ID - use your sandbox client ID for development
# Get this from https://developer.paypal.com/
VITE_PAYPAL_CLIENT_ID=your-sandbox-client-id-here

# Notes:
# - These variables are embedded at build time, not runtime
# - Use sandbox credentials for development
# - Never commit real credentials to version control
# - For production, set these via Docker build args or CI/CD variables
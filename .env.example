# Environment Variables for Complete MN Sigs Storefront
# Copy to .env and configure with your actual values

# PayPal Configuration (required for backend)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_MODE=sandbox

# Frontend Configuration (used in Docker build)
# These are embedded at build time, not runtime
VITE_API_BASE_URL=http://localhost:8000
VITE_PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID}

# Development Notes:
# 1. Get PayPal credentials from https://developer.paypal.com/
# 2. Use sandbox credentials for development
# 3. PAYPAL_CLIENT_ID is used by both frontend and backend
# 4. PAYPAL_CLIENT_SECRET is backend-only (never expose to frontend)
# 5. For production, set PAYPAL_MODE=live and use production credentials
---
import { Image } from "astro:assets"
import { NAV_LINKS } from "../config"
import logo from "../assets/logo.png"

// Normalise so "/about" and "/about/" both match, and "/" stays "/"
const current = Astro.url.pathname.replace(/\/+$/, "") || "/"
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <Image
        src={logo}
        alt=""
        width={43}
        height={44}
        densities={[1, 2]}
        loading="eager"
      />
      <span>Greater Minnesota<br />Alumni Chapter</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          NAV_LINKS.map(link => {
            const children = "children" in link ? link.children : undefined
            // A parent whose child route is open is highlighted but must not
            // claim aria-current="page" — that belongs to the child link.
            const childActive = children?.some(child => child.href === current)
            return (
              <li class={children ? "has-submenu" : undefined}>
                <a
                  href={link.href}
                  aria-current={link.href === current ? "page" : undefined}
                  class={childActive ? "is-ancestor" : undefined}
                >
                  {link.label}
                </a>
                {children && (
                  <ul class="site-nav__submenu">
                    {children.map(child => (
                      <li>
                        <a
                          href={child.href}
                          aria-current={
                            child.href === current ? "page" : undefined
                          }
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</header>

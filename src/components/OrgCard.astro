---
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"

type Role = CollectionEntry<"provinceRoles">

interface Props {
  node: Role
  roleById: Map<string, Role>
  chapterNames: Map<string, string>
  /** Chapter is only labelled where it isn't already implied by the parent. */
  showChapter?: boolean
}

const { node, roleById, chapterNames, showChapter = false } = Astro.props

const chapterId = node.data.chapter?.id ?? null

// Dotted lines are advisory, not reporting, so they are described in words on
// the node itself; the matrix further down the page shows the same data as a
// grid. Drawing them as lines would mean 10 crossing edges.
const advisedChapters = node.data.advises
  .map(ref => roleById.get(ref.id)?.data.chapter?.id)
  .filter((id): id is string => Boolean(id))
  .map(id => chapterNames.get(id))
  .filter((name): name is string => Boolean(name))
---

<div class="org-card">
  {
    node.data.photo && node.data.person && (
      <Image
        class="org-card__photo"
        src={node.data.photo}
        alt={`${node.data.person}, ${node.data.title}`}
        width={128}
        height={128}
        loading="lazy"
      />
    )
  }
  {
    showChapter && chapterId && (
      <p class="org-card__scope">{chapterNames.get(chapterId)}</p>
    )
  }
  <p class="org-card__title">{node.data.title}</p>
  {node.data.person && <p class="org-card__person">{node.data.person}</p>}
  {
    node.data.email && (
      <p class="org-card__email">
        <a href={`mailto:${node.data.email}`}>{node.data.email}</a>
      </p>
    )
  }
  {node.data.termLabel && <p class="org-card__term">{node.data.termLabel}</p>}
  {
    advisedChapters.length > 0 && (
      <p class="org-card__dotted">
        Advises the chapter advisors of {advisedChapters.join(", ")}.
      </p>
    )
  }
  {node.data.summary && <p class="org-card__summary">{node.data.summary}</p>}
</div>

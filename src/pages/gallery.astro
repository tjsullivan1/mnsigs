---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import Page from "../layouts/Page.astro"

const photos = (await getCollection("gallery")).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<Page
  title="Our Brothers"
  description="Photos from Grand Chapter, province conferences, and events of the Greater Minnesota Alumni Chapter."
  wide
>
  <ul class="gallery">
    {
      photos.map((photo, i) => (
        <li>
          <figure>
            <a href={photo.data.src} target="_blank" rel="noopener noreferrer">
              <Image
                src={photo.data.src}
                alt={photo.data.alt}
                width={800}
                height={600}
                format="webp"
                quality="mid"
                loading={i < 3 ? "eager" : "lazy"}
              />
            </a>
            <figcaption>{photo.data.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Page>
